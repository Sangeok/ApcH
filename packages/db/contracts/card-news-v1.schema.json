          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "executionEpoch": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "invocationId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "templateVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "fontVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "draftDocument": {
          "$ref": "#/$defs/draft"
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+[^/]$"
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
