# Auth
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL=""                          # Production: https://podcastclipper.com
ADMIN_EMAILS=""
# 검증기(FEAT-25) 로그인용 긴 난수(선택). 설정 시에만 읽기 전용 verifier 세션 provider가
# 등록된다. release-verifier 루틴(FEAT-26)의 claude.ai 환경변수에도 같은 값을 둔다.
VERIFIER_SECRET=""

# Database (Neon)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET_NAME=""

# CloudFront CDN (선택, PEM 키는 base64 인코딩)
CLOUDFRONT_DOMAIN=""
CLOUDFRONT_KEY_PAIR_ID=""
CLOUDFRONT_PRIVATE_KEY=""

# Video Processing
PROCESS_VIDEO_ENDPOINT=""
PROCESS_VIDEO_ENDPOINT_AUTH=""
# Modal이 처리 완료를 /api/webhooks/modal 로 콜백할 때 쓰는 공유 시크릿.
# Modal secret(ai-podcast-clipper-secret)에 같은 값이 들어 있어야 한다 —
# 양쪽이 다르면 콜백이 401로 조용히 버려지고 업로드가 처리중에서 멈춘다.
MODAL_WEBHOOK_SECRET=""

# Inngest (Vercel Integration 사용 시 자동 주입됨)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Polar Payment
# Sandbox: sandbox.polar.sh에서 발급 | Production: polar.sh에서 발급
POLAR_ACCESS_TOKEN="polar_pat_..."
POLAR_WEBHOOK_SECRET_DEV="whsec_..."
POLAR_WEBHOOK_SECRET_PROD="whsec_..."
# "sandbox" 또는 "production" (미설정 시 NODE_ENV 기반 자동 결정)
POLAR_SERVER="sandbox"

# Sentry (Vercel Production 스코프에만 설정. 미설정 시 Sentry.init은 no-op,
# 소스맵 업로드만 조용히 건너뛰고 빌드는 통과한다)
SENTRY_DSN=""                        # 런타임: 에러 전송 대상
SENTRY_AUTH_TOKEN=""                 # 빌드타임: 소스맵 업로드 (project:releases 스코프)
SENTRY_ORG=""                        # 빌드타임: org slug (env.js가 아닌 next.config.js가 직접 읽음)
SENTRY_PROJECT=""                    # 빌드타임: project slug

# Public
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUBSCRIPTION_ENABLED=false
